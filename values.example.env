# Placeholder values for this repo's skills.
#
# Every {{...}} in collections/ is listed here. Copy this file to
# values.local.env (gitignored), fill in the real values, then run:
#
#     ./hydrate.sh ~/.claude/skills
#
# Nothing in this file should ever hold a real value. values.local.env does.

# --- GitLab ---------------------------------------------------------------
GITLAB_HOST=              # e.g. git.example.com
GITLAB_GROUP=             # the group that owns the repos

# --- Public / staging hosts ---------------------------------------------------
STOREFRONT_HOST=          # production storefront hostname
STAGING_DOMAIN=               # shared domain the staging hosts hang off
ADMIN_STAGING_HOST=
SERVICE_STAGING_HOST=
WEB_STAGING_HOST=

# --- staging Postgres cluster -------------------------------------------------
STAGING_DB_HOST=
STAGING_DB_IP=                # what STAGING_DB_HOST resolves to
STAGING_DB_USER=              # personal read/write role
STAGING_DB_PASSWORD=          # SECRET
STAGING_MANIFEST=        # k8s manifest filename for the staging env
STAGING_JOB=             # CI deploy job / environment name
APP_DB=                   # application database name
APP_DB_USER=              # application role
APP_DB_PASSWORD=          # SECRET

# --- Production Postgres --------------------------------------------------
PROD_DB=                  # short name used in prose
PROD_DB_CLUSTER=          # full cluster name

# --- Warehouse -----------------------------------------------------------
WAREHOUSE_HOST=
WAREHOUSE_DB=
WAREHOUSE_USER=           # working role
WAREHOUSE_PASSWORD=       # SECRET
WAREHOUSE_USER_ALT=       # personal role, pending grant
WAREHOUSE_PASSWORD_ALT=   # SECRET
HISTORY_SCHEMA=         # raw device-history schema
REPORTING_SCHEMA=         # reporting mirror schema
OBS_BUCKET=               # object-storage bucket backing the warehouse tables
WAREHOUSE_PRODUCT=       # warehouse DB product name
WAREHOUSE_CLI=           # its native CLI binary
WAREHOUSE_PY_DRIVER=     # pure-Python fallback driver package for its wire protocol
WAREHOUSE_STORAGE=       # object-storage service backing its tables

# --- Network --------------------------------------------------------------
VPN_CLIENT_IP=            # VPN client address to request on whitelists

# --- Company / product identity -------------------------------------------
COMPANY=                  # employer name
PRODUCT=                  # system / platform acronym
ITEM=                     # the thing the product sells (plural noun)
WORKSPACE_ROOT=           # the umbrella dir all repos sit under, e.g. ~/<this>
CONTEXT_SRC_DIR=          # personal context-template source dir that /import copies from
REPO_PREFIX=              # shared prefix on the repo names
SERVICE_REPO=
WEB_REPO=
ADMIN_REPO=
KB_REPO=
CAMPAIGNS_REPO=
SUPPORT_AI=               # vendor/support AI workflow family in n8n
KB_WORKFLOW=              # knowledge-base workflow name
SALES_CHANNEL=            # channel code used in campaign attribution
COHORT=                   # the free-device cohort name
WAREHOUSE_VENDOR=         # who makes the warehouse DB
STORE_SLUG_EXAMPLE=       # example store_locations.id slug
GITLAB_HOST_RE=           # GITLAB_HOST with dots escaped, for sed patterns
